# 本文件只列键名与默认值，不写入任何真实凭据
GIPS_ENV=dev

# 存储
GIPS_DB_PATH=var/gips.db
GIPS_OBJECT_STORE_DIR=var/objects
GIPS_MILVUS_URI=http://127.0.0.1:19530
GIPS_MILVUS_COLLECTION=gips_chunks
GIPS_REDIS_URL=redis://127.0.0.1:6379/0

# 模型权重（GGUF 未就位时保持 llm_backend=fake）
GIPS_EMBED_MODEL_PATH=models/bge-m3
GIPS_RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
GIPS_GGUF_PATH=models/generate/qwen3-8b-q4_k_m.gguf
GIPS_LLM_BACKEND=fake

# 推理预算（4096 上下文为 8GB 卡的硬上限）
GIPS_LLM_N_CTX=4096
GIPS_LLM_N_GPU_LAYERS=-1
GIPS_LLM_CTX_BUDGET_RATIO=0.85
GIPS_GPU_PEAK_LIMIT_GB=7.5

# 解析与切分（禁用固定长度带重叠）
GIPS_TEXT_LAYER_MIN_CHARS_PAGE=200
GIPS_TEXT_LAYER_SCAN_MAX_CHARS_PAGE=50
GIPS_CHUNKER_STRATEGY=provision
GIPS_CHUNKER_OVERLAP=0
GIPS_CLEANER_VERSION=cleaner-v1

# 云 OCR（凭据只允许存在于出域网关进程）
GIPS_OCR_PROVIDER_ORDER=aliyun,tencent
GIPS_ALIYUN_AK=replace-me
GIPS_ALIYUN_SK=replace-me
GIPS_TENCENT_AK=replace-me
GIPS_TENCENT_SK=replace-me
GIPS_EGRESS_ENABLED=true
